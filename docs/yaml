version: '3.8'

networks:
  snipeit-net:
    driver: bridge

services:
  snipe-db:
    image: mariadb:10.11
    container_name: snipe-backend-db
    restart: always
    networks:
      - snipeit-net
    volumes:
      - snipe-db-vol:/var/lib/mysql
    environment:
      - MYSQL_DATABASE=snipeit
      - MYSQL_USER=snipe_user
      - MYSQL_PASSWORD=EnterprisePassword123!
      - MYSQL_ROOT_PASSWORD=RootDBPassword987!

  snipe-it:
    image: snipe/snipe-it:latest
    container_name: snipe-web-app
    restart: always
    networks:
      - snipeit-net
    ports:
      - "8080:80"
    volumes:
      - snipe-vol:/var/www/html/storage/app
    depends_on:
      - snipe-db
    environment:
      - APP_URL=http://SERVER_IP_ADDRESS:8080
      - APP_TIMEZONE=Europe/Istanbul
      - APP_LOCALE=en
      - DB_CONNECTION=mysql
      - DB_HOST=snipe-db
      - DB_DATABASE=snipeit
      - DB_USERNAME=snipe_user
      - DB_PASSWORD=EnterprisePassword123!
      - APP_KEY=ChangeMeOrArtisanKeyGenerate

volumes:
  snipe-db-vol:
  snipe-vol:
